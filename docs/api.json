  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AccessType": {
        "type": "string",
        "enum": [
          "PUBLIC",
          "LINK"
        ]
      },
      "PollStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "PUBLISHED",
          "CLOSED",
          "ARCHIVED"
        ]
      },
      "QuestionType": {
        "type": "string",
        "enum": [
          "SINGLE",
          "MULTIPLE"
        ]
      },
      "AnswerOptionRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": ".*\\S.*"
          }
        },
        "required": [
          "text"
        ]
      },
      "QuestionRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": ".*\\S.*"
          },
          "type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerOptionRequest"
            },
            "maxItems": 20
          }
        },
        "required": [
          "text",
          "type",
          "options"
        ]
      },
      "PollRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": ".*\\S.*"
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "accessType": {
            "$ref": "#/components/schemas/AccessType"
          },
          "anonymous": {
            "type": "boolean"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionRequest"
            },
            "maxItems": 50
          },
          "allowVoteChange": {
            "type": "boolean",
            "default": false,
            "description": "Lets a participant change or revoke a vote while the poll is published (Vote Service enforces it). Not allowed in an anonymous poll."
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Scheduled end as an ISO 8601 instant with an offset. Optional in drafts, required and in the future when publishing. Immutable after publication."
          }
        },
        "required": [
          "title",
          "description",
          "accessType",
          "anonymous",
          "questions"
        ]
      },
      "AnswerOptionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ]
      },
      "QuestionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerOptionResponse"
            }
          }
        },
        "required": [
          "id",
          "text",
          "type",
          "options"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": []
            }
          }
        },
        "required": []
      },
      "PollSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PollStatus"
          },
          "accessType": {
            "$ref": "#/components/schemas/AccessType"
          },
          "anonymous": {
            "type": "boolean"
          },
          "blocked": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Scheduled end as an ISO 8601 instant with an offset. Optional in drafts, required and in the future when publishing. Immutable after publication."
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "accessType",
          "anonymous",
          "blocked",
          "createdAt"
        ]
      },
      "PollResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PollStatus"
          },
          "accessType": {
            "$ref": "#/components/schemas/AccessType"
          },
          "anonymous": {
            "type": "boolean"
          },
          "blocked": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "ownerId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "shareToken": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Returned only to owner/admin."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
