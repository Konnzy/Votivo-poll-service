DB_PASSWORD=change-me-local
DB_USERNAME=poll
DB_URL=jdbc:postgresql://localhost:5433/polls
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/votivo
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/votivo/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=poll-service

# Host-side broker address for bootRun. Docker uses rabbitmq:5672 internally.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5674
RABBITMQ_MANAGEMENT_PORT=15674
RABBITMQ_USER=poll
RABBITMQ_PASSWORD=change-me-rabbit-local
RABBITMQ_VHOST=/
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL=1s
